# --- App ---
# URL base do app, usada para montar links de confirmação de e-mail/reset de senha.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---
# Encontre em: Project Settings > API no painel do Supabase.
# NEXT_PUBLIC_* são expostas ao navegador — só coloque aqui a URL e a chave anon (publica).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave service_role — NUNCA usar no frontend. Apenas em rotas server-side/API.
SUPABASE_SERVICE_ROLE_KEY=

# --- IA (Anthropic) ---
# Usada apenas no backend (rotas server-side), nunca exposta ao cliente.
ANTHROPIC_API_KEY=

# --- Pagamentos (Stripe) ---
# Chave secreta — Dashboard do Stripe > Developers > API keys. Use a de modo
# TESTE (sk_test_...) em desenvolvimento. Nunca no frontend.
STRIPE_SECRET_KEY=

# Segredo de assinatura do endpoint de webhook — gerado ao criar o webhook
# apontando para /api/webhooks/stripe (ou via `stripe listen` em dev local).
STRIPE_WEBHOOK_SECRET=
